# Download button base. It already has af_web_dp, af_xp=custom, and pid=Indeed.
# The job page replaces pid for the feed channel: Indeed, Adzuna, or ZipRecruiter.
# Each button appends only &c={title_id}&af_sub1={postalcode}&af_sub2={referencenumber}.
# Do not add c=indeed_launch or a second pid.
ONELINK_BASE_URL=https://hetalretail.onelink.me/sfUI?af_web_dp=http%3A%2F%2Findeed.hetalretail.com%2F&af_xp=custom&pid=Indeed

# Weekly ZIP sheet. Leave unset to download the published Hetal CSV.
# Set JOBS_CSV_PATH to a local export instead of the URL.
# JOBS_CSV_URL=https://docs.google.com/spreadsheets/d/1jRI2rzi_JONSOLvSaBebV54QUV8wJe57tfV74zPcDwM/export?format=csv
# IMPORT_WEEK=2026-11-02

# Indeed uses this address to verify the employer. It is not shown on the job page.
FEED_CONTACT_EMAIL=marketing@hetalretail.com

# Company name in the XML feed, on the site, and in JobPosting JSON-LD.
COMPANY_NAME=Hetal Retail

# Optional. Leave unset locally and on preview deploys so /feed.xml uses the
# host that was requested. Set this only when the public host differs from the
# request host, for example after jobs.hetalretail.com is live:
# SITE_URL=https://jobs.hetalretail.com

# Google Indexing API. Paste the service account email and PEM private key here.
# Keep them in .env.local. Never commit a key file or these values.
# The private key may use \n for line breaks inside double quotes.
# GOOGLE_INDEXING_CLIENT_EMAIL=jobs@project-id.iam.gserviceaccount.com
# GOOGLE_INDEXING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
