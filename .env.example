# Every apply button starts from this OneLink. The app leaves af_xp, c, and af_web_dp
# as written here. pid stays xml-hetal unless the job URL names a board (?channel= or
# ?source=). The title goes in af_adset. af_sub1 is the ZIP and af_sub2 is the
# reference number. Do not add a second c or pid, and do not put the title in c.
# Paste the same value into Vercel and Webflow.
ONELINK_BASE_URL=https://hetalretail.onelink.me/sfUI?af_xp=custom&pid=xml-hetal&c=xml-feed-hetal-website&af_web_dp=https%3A%2F%2Fwww.hetalretail.com%2Fbecome-a-hetalite

# Published Hetal ZIP sheet. Leave unset to use this CSV.
# Set JOBS_CSV_PATH to a local export instead of the URL.
# JOBS_CSV_URL=https://docs.google.com/spreadsheets/d/1jRI2rzi_JONSOLvSaBebV54QUV8wJe57tfV74zPcDwM/export?format=csv&gid=0

# Webflow Cloud mounts the app at /jobs. Leave this unset to use that path.
# NEXT_PUBLIC_BASE_PATH=/jobs

# Indeed uses this address to verify the employer. It is not shown on the job page.
FEED_CONTACT_EMAIL=marketing@hetalretail.com

# Company name in the XML feed, on the site, and in JobPosting JSON-LD.
COMPANY_NAME=Hetal Retail

# Public origin for the feed, sitemap, and canonical job URLs.
# Production uses https://www.hetalretail.com when this is unset.
# Leave it unset locally so validation hits the dev server.
# SITE_URL=https://www.hetalretail.com

# Google Indexing API. Paste the service account email and PEM private key here.
# Keep them in .env.local. Never commit a key file or these values.
# The private key may use \n for line breaks inside double quotes.
# GOOGLE_INDEXING_CLIENT_EMAIL=jobs@project-id.iam.gserviceaccount.com
# GOOGLE_INDEXING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
